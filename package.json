{
  "name": "ha-3d-dashboard",
  "description": "Interaktiver 3D-Grundriss als Home-Assistant-Panel (three.js, offline, touch)",
  "license": "MIT",
  "repository": "github:zitroaen/3d-ha-dashboard",
  "private": true,
  "version": "0.31.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "node tests/devserver.mjs",
    "demo": "node examples/demo/build-house.mjs",
    "validate": "node tests/validate-data.mjs",
    "link-check": "node tests/link-check.mjs",
    "test:unit": "node tests/model.test.mjs",
    "test:screens": "node tests/screenshots.mjs",
    "test:interaction": "node tests/interaction.mjs",
    "test:demo": "node tests/demo.mjs",
    "test:shared": "node tests/shared.mjs",
    "test:perf": "node tests/performance.mjs",
    "test:webkit": "node tests/webkit.mjs",
    "privacy": "node tests/privacy-guard.mjs",
    "test:integration": "node tests/integration-check.mjs",
    "package": "node scripts/package-integration.mjs",
    "checks": "npm run privacy && npm run test:integration && npm run validate && npm run test:unit && npm run link-check",
    "test": "npm run checks && npm run build && npm run test:screens && npm run test:interaction && npm run test:demo && npm run test:shared && npm run test:perf"
  },
  "dependencies": {
    "js-yaml": "^5.4.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
