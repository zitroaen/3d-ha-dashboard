{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zitroaen/3d-ha-dashboard/schema/model.schema.json",
  "title": "3D-HA-Dashboard Modell",
  "description": "Datenmodell Version 2. Beschreibung der Felder: docs/DATA_MODEL.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "site", "buildings"],
  "properties": {
    "schema": { "const": "ha3d" },
    "version": { "const": 2 },
    "site": { "$ref": "#/$defs/site" },
    "buildings": { "type": "array", "items": { "$ref": "#/$defs/building" } },
    "outdoor": { "type": "array", "items": { "$ref": "#/$defs/outdoor" } },
    "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } },
    "surfaces": { "type": "object", "description": "eigene Oberflächen bzw. Änderungen an der Bibliothek (docs/LIBRARY.md)", "propertyNames": { "pattern": "^[a-z0-9_]+$" }, "additionalProperties": { "$ref": "#/$defs/surfaceDef" } },
    "window_styles": { "type": "object", "description": "eigene Fensterarten bzw. Änderungen (docs/LIBRARY.md)", "propertyNames": { "pattern": "^[a-z0-9_]+$" }, "additionalProperties": { "$ref": "#/$defs/windowStyle" } },
    "door_styles": { "type": "object", "description": "eigene Türarten bzw. Änderungen (docs/LIBRARY.md)", "propertyNames": { "pattern": "^[a-z0-9_]+$" }, "additionalProperties": { "$ref": "#/$defs/doorStyle" } },
    "models": { "type": "array", "description": "eigene Modelle (models/<id>.yaml) für den Katalog, auch ungenutzte", "items": { "$ref": "#/$defs/id" } },
    "connections": { "type": "array", "description": "reserviert für spätere Versionen", "maxItems": 0 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "num": { "type": "number" },
    "pos": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "polygon": { "type": "array", "items": { "$ref": "#/$defs/pos" }, "minItems": 3 },
    "terrainPolygon": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 3 },
      "minItems": 3
    },
    "surface": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "Oberfläche aus library/surfaces.yaml oder `surfaces` (docs/LIBRARY.md)" },
    "surfaceDef": {
      "type": "object",
      "description": "Oberfläche: Muster oder Bild (docs/LIBRARY.md)",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "base": { "$ref": "#/$defs/surface" },
        "pattern": { "enum": ["planks", "herringbone", "chevron", "basket", "tiles", "siding", "roof_tiles", "stone", "flagstone", "speckle", "lawn", "plain"] },
        "image": { "type": "string" },
        "size": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 1, "maxItems": 2 }] },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "variation": { "type": "number", "minimum": 0, "maximum": 1 },
        "joint": { "type": "number", "minimum": 0 },
        "joint_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "bond": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "const": "random" }] },
        "rows": { "type": "integer", "minimum": 1, "maximum": 3 },
        "angle": { "type": "number" },
        "strips": { "type": "integer", "minimum": 1 },
        "spread": { "type": "number", "minimum": 0 },
        "seed": { "type": "integer" },
        "res": { "type": "number" },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "metalness": { "type": "number", "minimum": 0, "maximum": 1 },
        "relief": { "type": "number", "minimum": 0 },
        "bump": { "type": "number", "minimum": 0 },
        "outdoor": { "type": "boolean" },
        "edge": { "$ref": "#/$defs/surface" }
      }
    },
    "entityId": { "type": "string", "pattern": "^[a-z_]+\\.[a-z0-9_]+$" },
    "entityList": {
      "oneOf": [
        { "$ref": "#/$defs/entityId" },
        { "type": "array", "items": { "$ref": "#/$defs/entityId" }, "minItems": 1 }
      ]
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "north_deg": { "type": "number" },
        "ground": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "surface": { "$ref": "#/$defs/surface" } }
        },
        "weather": { "type": "string", "pattern": "^weather\\.[a-z0-9_]+$" },
        "attribution": {
          "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
        },
        "terrain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["heights"],
          "properties": {
            "origin": { "$ref": "#/$defs/pos" },
            "cell": { "type": "number", "exclusiveMinimum": 0 },
            "heights": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "array", "minItems": 2, "items": { "type": ["number", "null"] } }
            },
            "shading": { "type": "number", "minimum": 0, "maximum": 1.5 },
            "texture": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["file"],
                  "properties": {
                    "file": { "type": "string", "minLength": 1 },
                    "origin": { "$ref": "#/$defs/pos" },
                    "size": {
                      "oneOf": [
                        { "type": "number", "exclusiveMinimum": 0 },
                        { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 2, "maxItems": 2 }
                      ]
                    },
                    "rot": { "type": "number" },
                    "affine": { "type": "array", "items": { "type": "number" }, "minItems": 6, "maxItems": 6 },
                    "strength": { "type": "number", "minimum": 0, "maximum": 1 },
                    "exclude": { "type": "array", "items": { "$ref": "#/$defs/polygon" } }
                  }
                }
              ]
            }
          }
        },
        "georef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin"],
          "properties": {
            "origin": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "north_deg": { "type": "number" },
            "floor": { "type": "number" },
            "crs": { "type": "string" }
          }
        }
      }
    },
    "building": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "floors"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "kind": { "enum": ["house", "garage", "garden_house", "carport", "other"] },
        "floors": { "type": "array", "items": { "$ref": "#/$defs/floor" }, "minItems": 1 },
        "styles": {
          "type": "object",
          "description": "Standard-Fenster- und Türarten des Gebäudes",
          "additionalProperties": false,
          "properties": { "window": { "$ref": "#/$defs/id" }, "door": { "$ref": "#/$defs/id" }, "exterior_door": { "$ref": "#/$defs/id" }, "front_door": { "$ref": "#/$defs/id" } }
        },
        "facade": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "plaster (Putz) oder eine Oberfläche" },
            "color": { "type": "string" },
            "corners": { "oneOf": [{ "type": "string" }, { "const": false }] },
            "flush": { "type": "boolean" },
            "plinth": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "height": { "type": "number", "minimum": 0 },
                "material": { "$ref": "#/$defs/surface" },
                "color": { "type": "string" }
              }
            }
          }
        },
        "roof": {
          "oneOf": [
            { "const": false },
            { "$ref": "#/$defs/roofPart" },
            { "type": "array", "items": { "$ref": "#/$defs/roofPart" }, "minItems": 1 }
          ]
        }
      }
    },
    "railing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": { "enum": ["balusters", "metal", "glass"] },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "edges": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "color": { "type": "string" }
      }
    },
    "roofPart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "type": { "enum": ["flat", "gable", "hip", "half_hip", "shed"] },
        "surface": { "$ref": "#/$defs/surface" },
        "color": { "type": "string" },
        "polygon": { "type": "array", "items": { "$ref": "#/$defs/pos" }, "minItems": 3 },
        "thickness": { "type": "number", "minimum": 0 },
        "pitch": { "type": "number", "exclusiveMinimum": 0, "maximum": 75 },
        "ridge": { "oneOf": [{ "type": "number" }, { "enum": ["x", "y"] }] },
        "slope": { "oneOf": [{ "type": "number" }, { "enum": ["+x", "-x", "+y", "-y", "x", "y"] }] },
        "overhang": { "type": "number", "minimum": 0 },
        "eaves": { "type": "number" },
        "top": { "type": "number", "minimum": 0 },
        "opening": { "type": "array", "items": { "$ref": "#/$defs/pos" }, "minItems": 3 },
        "hip_height": { "type": "number", "minimum": 0 },
        "hip_pitch": { "type": "number", "exclusiveMinimum": 0, "maximum": 85 },
        "railing": { "$ref": "#/$defs/railing" },
        "dormers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pos"],
            "properties": {
              "pos": { "$ref": "#/$defs/pos" },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "type": { "enum": ["shed", "flat", "gable"] },
              "pitch": { "type": "number", "minimum": 0, "maximum": 75 },
              "window": { "oneOf": [{ "type": "boolean" }, { "const": "openings" }] },
              "window_width": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "chimneys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pos"],
            "properties": {
              "pos": { "$ref": "#/$defs/pos" },
              "size": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 2, "maxItems": 2 },
              "height": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "level", "height", "rooms", "walls"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "level": { "type": "integer" },
        "elevation": { "type": "number" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "ha_floor": { "type": "string" },
        "rooms": { "type": "array", "items": { "$ref": "#/$defs/room" } },
        "walls": { "type": "array", "items": { "$ref": "#/$defs/wall" } },
        "windows": { "type": "array", "items": { "$ref": "#/$defs/window" } },
        "doors": { "type": "array", "items": { "$ref": "#/$defs/door" } }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "polygon"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "polygon": { "$ref": "#/$defs/polygon" },
        "surface": { "$ref": "#/$defs/surface" },
        "surface_rot": { "type": "number" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "ha_area": { "type": "string" },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["polygon", "surface"],
            "properties": {
              "polygon": { "$ref": "#/$defs/polygon" },
              "surface": { "$ref": "#/$defs/surface" },
              "surface_rot": { "type": "number" },
              "color": { "type": "string" }
            }
          }
        },
        "beams": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dir": { "oneOf": [{ "type": "number" }, { "enum": ["x", "y"] }] },
            "spacing": { "type": "number", "exclusiveMinimum": 0 },
            "size": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 2, "maxItems": 2 },
            "color": { "type": "string" }
          }
        }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["polygon"],
      "properties": { "polygon": { "$ref": "#/$defs/polygon" } }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rect"],
      "properties": {
        "rect": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "room": { "$ref": "#/$defs/id" },
        "sill": { "type": "number" },
        "top": { "type": "number" },
        "sashes": { "type": "integer", "minimum": 1 },
        "transom": { "type": "number", "minimum": 0, "maximum": 1 },
        "style": { "$ref": "#/$defs/id", "description": "Fensterart (library/openings.yaml oder window_styles)" }
      }
    },
    "door": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hinge", "end", "swing", "jamb"],
      "properties": {
        "hinge": { "$ref": "#/$defs/pos" },
        "end": { "$ref": "#/$defs/pos" },
        "swing": { "enum": [1, -1] },
        "jamb": { "$ref": "#/$defs/pos" },
        "type": { "enum": ["interior", "exterior"] },
        "leaf": { "enum": ["glass", "solid"] },
        "rooms": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "open_deg": { "type": "number" },
        "arch": { "type": "boolean" },
        "top": { "const": "arch" },
        "leaves": { "enum": [1, 2] },
        "style": { "$ref": "#/$defs/id", "description": "Türart (library/openings.yaml oder door_styles)" }
      }
    },
    "windowStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" }, "base": { "$ref": "#/$defs/id" },
        "frame": { "type": "number", "exclusiveMinimum": 0 }, "depth": { "type": "number", "exclusiveMinimum": 0 }, "sash": { "type": "number", "exclusiveMinimum": 0 },
        "offset": { "type": "number" }, "color": { "$ref": "#/$defs/hex" }, "sash_color": { "$ref": "#/$defs/hex" },
        "board": { "oneOf": [{ "$ref": "#/$defs/hex" }, { "const": false }] },
        "bars": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 }, "bar": { "type": "number", "exclusiveMinimum": 0 },
        "fixed": { "type": "boolean" }
      }
    },
    "doorStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" }, "base": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["interior", "exterior"] }, "leaf": { "enum": ["panel", "flush", "glass", "solid"] },
        "panels": { "type": "integer", "minimum": 1 }, "glass": { "type": "integer", "minimum": 0 },
        "color": { "$ref": "#/$defs/hex" }, "frame_color": { "$ref": "#/$defs/hex" }, "handle": { "$ref": "#/$defs/hex" },
        "bars": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 }, "bar": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "outdoor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "polygon"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "polygon": { "$ref": "#/$defs/terrainPolygon" },
        "surface": { "$ref": "#/$defs/surface" },
        "elevation": { "type": "number" },
        "edge": { "$ref": "#/$defs/surface" },
        "extend": { "type": "boolean" },
        "follow": { "enum": ["terrain"] },
        "railing": { "$ref": "#/$defs/railing" },
        "ha_area": { "type": "string" }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model", "pos"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "model": { "type": "string" },
        "space": { "$ref": "#/$defs/id" },
        "pos": { "$ref": "#/$defs/pos" },
        "rot": { "type": "number" },
        "elevation": { "type": "number" },
        "size": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 1, "maxItems": 3 },
        "params": { "type": "object" },
        "state": { "enum": ["on", "off"] },
        "stored": { "type": "boolean" },
        "light": { "$ref": "#/$defs/light" },
        "ha": { "$ref": "#/$defs/ha" }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height", "range"],
      "properties": {
        "mount": { "enum": ["ceiling", "pendant", "floor", "table", "wall", "spot"] },
        "height": { "type": "number" },
        "range": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "facing": { "$ref": "#/$defs/pos" }
      }
    },
    "ha": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "power": { "$ref": "#/$defs/entityList" },
            "info": { "$ref": "#/$defs/entityList" }
          }
        },
        "tap": { "$ref": "#/$defs/action" },
        "double_tap": { "$ref": "#/$defs/action" },
        "hold": { "$ref": "#/$defs/action" },
        "badge": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "show": { "type": "boolean" },
                "entities": { "$ref": "#/$defs/entityListOrEmpty" },
                "when": { "$ref": "#/$defs/condition" }
              }
            }
          ]
        },
        "player": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entity": { "$ref": "#/$defs/entityId" },
                "when": { "$ref": "#/$defs/condition" }
              }
            }
          ]
        }
      }
    },
    "entityListOrEmpty": {
      "oneOf": [
        { "$ref": "#/$defs/entityId" },
        { "type": "array", "items": { "$ref": "#/$defs/entityId" } }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity": { "$ref": "#/$defs/entityId" },
        "attribute": { "type": "string" },
        "state": { "oneOf": [{ "type": ["string", "number", "boolean"] }, { "type": "array", "items": { "type": ["string", "number", "boolean"] } }] },
        "not_state": { "oneOf": [{ "type": ["string", "number", "boolean"] }, { "type": "array", "items": { "type": ["string", "number", "boolean"] } }] },
        "above": { "type": "number" },
        "below": { "type": "number" }
      }
    },
    "action": {
      "oneOf": [
        { "enum": ["toggle", "more-info", "none"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {
            "action": { "enum": ["toggle", "more-info", "service", "navigate", "none"] },
            "entity": { "$ref": "#/$defs/entityId" },
            "service": { "type": "string", "pattern": "^[a-z_]+\\.[a-z0-9_]+$" },
            "data": { "type": "object" },
            "path": { "type": "string", "pattern": "^/" },
            "confirm": { "type": "string" }
          },
          "allOf": [
            { "if": { "properties": { "action": { "const": "service" } } }, "then": { "required": ["service"] } },
            { "if": { "properties": { "action": { "const": "navigate" } } }, "then": { "required": ["path"] } }
          ]
        }
      ]
    }
  }
}
